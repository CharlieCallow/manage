{
  "name": "@manage/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron + React desktop shell for manage",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "echo 'desktop lint: TODO — wire ESLint in a later phase' && exit 0",
    "test": "echo 'desktop tests: TODO — add vitest suite in a later phase' && exit 0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@manage/shared-types": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/node": "^22.9.0",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "ai.manage.app",
    "productName": "manage",
    "directories": {
      "output": "out"
    },
    "files": ["dist-electron/**/*", "dist/**/*"]
  }
}
